        {
          "name": "POST create product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('productName', 'PROD-' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('createdProductId', json.id);",
                  "  if (json.id) pm.collectionVariables.set('productId', json.id);",
                  "  if (json.name) pm.collectionVariables.set('productName', json.name);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
